.venv/
.valuation_state/
valuation-vault*/
state/
# private working runs stay out; the committed public example is re-included
# below (a fully-excluded parent dir cannot be re-included, hence runs/*)
runs/*
__pycache__/
*.py[cod]
.pytest_cache/
pytest-of-root/
pip-*/
*.egg-info/
.claude/worktrees/
!runs/kisco-104700/
runs/kisco-104700/out/
!runs/shinhanalpha-293940/
runs/shinhanalpha-293940/out/
!runs/daehansteel-084010/
runs/daehansteel-084010/out/

# Packaging output. `pip wheel .` writes a full copy of the package here, and a
# tracked copy would drift from src/ silently — and be picked up by anything
# that scans importable files.
build/
dist/
*.egg-info/
