#!/usr/bin/env python3
from __future__ import annotations

import json, math, re, time
from collections import Counter
from io import StringIO
from pathlib import Path

import numpy as np
import pandas as pd
import requests
import yaml
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "artifacts" / "calibration_hierarchical_v2"
OUT.mkdir(parents=True, exist_ok=True)
CFG = yaml.safe_load((ROOT / "config" / "semiconductor_hierarchical_research_calibration.yaml").read_text(encoding="utf-8"))
SEED = yaml.safe_load((ROOT / "config" / "semiconductor_calibration_seed.yaml").read_text(encoding="utf-8"))

EXCHANGE = {
"005930":"krx","000660":"krx","000990":"krx","042700":"krx","240810":"kosdaq","036930":"kosdaq","084370":"kosdaq","095610":"kosdaq","281820":"krx","083310":"kosdaq","039030":"kosdaq","089030":"kosdaq","348210":"kosdaq","140860":"kosdaq","067310":"kosdaq","036540":"kosdaq","061970":"kosdaq","033640":"kosdaq","357780":"kosdaq","005290":"kosdaq","064760":"kosdaq","166090":"kosdaq","095340":"kosdaq","131970":"kosdaq","183300":"kosdaq","319660":"kosdaq","074600":"kosdaq","101490":"kosdaq","098460":"kosdaq","083450":"kosdaq"}
COMPANIES = [(r["name"], str(r["ticker"]), EXCHANGE[str(r["ticker"])], tuple(r["sub_industries"])) for r in SEED["companies"]]
TRAIN = [str(x) for x in CFG["training_origins"]]
HOLDOUT = [str(x) for x in CFG["holdout_origins"]]
EXCLUDE = {(str(x["ticker"]), str(x["origin"])) for x in CFG["exclusions"]}
FEATURES = [str(x) for x in CFG["features"]]
EVENTS = tuple(CFG["events"].keys())
SCENARIOS = ("Down", "Core", "Bull")
PRIOR = np.array([float(CFG["analyst_prior"][s]) for s in SCENARIOS])
RNG_SEED = int(CFG["model"]["random_seed"])
UA = "Mozilla/5.0 (compatible; PRISM-hierarchical-calibration-v2; +https://github.com/newwonwoo/valuation)"
S = requests.Session(); S.headers.update({"User-Agent": UA})


def flatcol(c):
    if isinstance(c, tuple):
        parts=[str(x) for x in c if str(x)!='nan' and not str(x).startswith('Unnamed')]
        return parts[-1] if parts else str(c[-1])
    return str(c)

def clean_label(x): return re.sub(r"\s+", " ", str(x)).strip()

def num(x):
    if x is None or (isinstance(x,float) and math.isnan(x)): return None
    s=str(x).strip().replace(',','').replace('%','')
    if s in {'','-','—','nan','None'}: return None
    neg=s.startswith('(') and s.endswith(')')
    if neg: s=s[1:-1]
    try: v=float(s)
    except Exception: return None
    return -v if neg else v

def fetch_tables(url):
    last=None
    for attempt in range(4):
        r=S.get(url,timeout=35); last=r
        if r.status_code==200 and ('Free Cash Flow' in r.text or 'Revenue' in r.text):
            return pd.read_html(StringIO(r.text))
        time.sleep(1.0+attempt)
    raise RuntimeError(f"fetch failed {last.status_code if last is not None else 'NA'}: {url}")

def table_rows(tables):
    rows={}
    for df in tables:
        df=df.copy(); first0=df.columns[0]; fiscal_idx=None
        for idx in df.index:
            lead=clean_label(df.loc[idx,first0])
            if lead in {'Fiscal Quarter','Fiscal Year'}: fiscal_idx=idx; break
        if fiscal_idx is not None:
            header=[clean_label(x) for x in df.loc[fiscal_idx].tolist()]
            df=df.loc[df.index>fiscal_idx].copy(); df.columns=header
        else: df.columns=[flatcol(c) for c in df.columns]
        if df.empty: continue
        first=df.columns[0]
        for _,r in df.iterrows():
            label=clean_label(r[first])
            if label and label not in rows:
                rows[label]={clean_label(c):r[c] for c in df.columns[1:]}
    return rows

def qcanon(c):
    m=re.search(r"Q([1-4])\s*(20\d{2})",c); return f"{m.group(2)}Q{m.group(1)}" if m else None

def ycanon(c):
    m=re.search(r"FY\s*(20\d{2})",c); return int(m.group(1)) if m else None

def extract_series(rows,label,kind):
    key=label if label in rows else None
    if key is None:
        fallback=[x for x in rows if clean_label(x).startswith(label+' ') and clean_label(x)!=label+' Growth']
        if fallback: key=min(fallback,key=len)
    if key is None: return {}
    out={}
    for c,v in rows[key].items():
        p=qcanon(c) if kind=='q' else ycanon(c)
        if p is not None: out[p]=num(v)
    return out

def fetch_company(name,ticker,exchange,subindustries):
    base=f"https://stockanalysis.com/quote/{exchange}/{ticker}/financials/"
    qrows=table_rows(fetch_tables(base+'?p=quarterly')); arows=table_rows(fetch_tables(base))
    out={"name":name,"ticker":ticker,"subindustries":subindustries,"url":base,"q":{},"annual":{}}
    qlabels={"revenue":"Revenue","fcf":"Free Cash Flow","fcf_margin":"FCF Margin","fcf_growth":"Free Cash Flow Growth","revenue_growth":"Revenue Growth","operating_margin":"Operating Margin"}
    for k,l in qlabels.items(): out['q'][k]=extract_series(qrows,l,'q')
    for k,l in {"revenue":"Revenue","fcf":"Free Cash Flow"}.items(): out['annual'][k]=extract_series(arows,l,'y')
    for y in range(2021,2027):
        q4=f"{y}Q4"
        for metric in ('revenue','fcf'):
            if out['q'][metric].get(q4) is None and out['annual'][metric].get(y) is not None:
                prior=[out['q'][metric].get(f"{y}Q{i}") for i in (1,2,3)]
                if all(v is not None for v in prior): out['q'][metric][q4]=out['annual'][metric][y]-sum(prior)
        rev=out['q']['revenue'].get(q4); fcf=out['q']['fcf'].get(q4)
        if rev not in (None,0) and fcf is not None and out['q']['fcf_margin'].get(q4) is None: out['q']['fcf_margin'][q4]=100.0*fcf/rev
    return out

def shift(q,n=4):
    y=int(q[:4]); qq=int(q[-1])+n
    while qq>4: y+=1; qq-=4
    while qq<1: y-=1; qq+=4
    return f"{y}Q{qq}"

def feature_row(d,origin):
    row={f:d['q'].get(f,{}).get(origin) for f in FEATURES}
    if row.get('fcf_growth') is None:
        cur=d['q']['fcf'].get(origin); prev=d['q']['fcf'].get(shift(origin,-4))
        if cur is not None and prev not in (None,0): row['fcf_growth']=100.0*(cur/prev-1.0)
    if row.get('revenue_growth') is None:
        cur=d['q']['revenue'].get(origin); prev=d['q']['revenue'].get(shift(origin,-4))
        if cur is not None and prev not in (None,0): row['revenue_growth']=100.0*(cur/prev-1.0)
    return row

def event_value(d,event,origin,outcome):
    rule=CFG['events'][event]; metric=rule['outcome_metric']; op=rule['rule']; threshold=float(rule['threshold'])
    a=d['q'].get(metric,{}).get(origin); b=d['q'].get(metric,{}).get(outcome)
    if a is None or b is None: return None,None
    if op=='relative_change_at_most':
        if a==0: return None,None
        measured=b/a-1.0; occurred=measured<=threshold
    elif op=='delta_at_most': measured=b-a; occurred=measured<=threshold
    else: raise ValueError(f"unsupported event rule {op}")
    return bool(occurred),float(measured)

def scenario_from_bits(bits):
    n=sum(int(x) for x in bits)
    return 'Bull' if n==0 else ('Core' if n==1 else 'Down')

def brier_multiclass(P,y,classes=3):
    return float(np.mean(np.sum((P-np.eye(classes)[y])**2,axis=1)))

def brier_binary(p,y): return float(np.mean((p-y)**2))

def make_pipe():
    return Pipeline([('impute',SimpleImputer(strategy='median')),('scale',StandardScaler()),('model',LogisticRegression(max_iter=int(CFG['model']['max_iter']),C=float(CFG['model']['regularization_C'])))])
