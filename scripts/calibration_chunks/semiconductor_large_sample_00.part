def qparse(q: str) -> tuple[int, int]:
    return int(q[:4]), int(q[-1])

def qfmt(y: int, q: int) -> str:
    while q <= 0:
        y -= 1
        q += 4
    while q > 4:
        y += 1
        q -= 4
    return f"{y}Q{q}"

def qshift(q: str, delta: int) -> str:
    y, qq = qparse(q)
    return qfmt(y, qq + delta)

def amount(v):
    if v is None:
        return None
    s = str(v).strip().replace(",", "")
    if not s or s == "-":
        return None
    if s.startswith("(") and s.endswith(")"):
        s = "-" + s[1:-1]
    try:
        return float(s)
    except Exception:
        return None

def norm_name(s: str) -> str:
    return "".join(ch for ch in (s or "") if ch.isalnum()).lower()

def choose_row(rows, metric):
    candidates = []
    for r in rows:
        sj = (r.get("sj_div") or "").upper()
        aid = (r.get("account_id") or "")
        nm = norm_name(r.get("account_nm") or "")
        if metric == "revenue":
            if sj not in {"IS", "CIS"}:
                continue
            score = 0
            if "RevenueFromContractsWithCustomers" in aid: score += 100
            if aid.endswith("_Revenue") or aid == "ifrs-full_Revenue": score += 90
            if nm in {"매출액", "수익매출액", "영업수익"}: score += 80
            if score: candidates.append((score, r))
        elif metric == "cfo":
            if sj != "CF":
                continue
            score = 0
            if "CashFlowsFromUsedInOperatingActivities" in aid: score += 100
            if nm in {"영업활동현금흐름", "영업활동으로인한현금흐름"}: score += 90
            if score: candidates.append((score, r))
        elif metric == "op_income":
            if sj not in {"IS", "CIS"}:
                continue
            score = 0
            if "OperatingIncomeLoss" in aid: score += 100
            if nm in {"영업이익", "영업이익손실"}: score += 90
            if score: candidates.append((score, r))
    if not candidates:
        return None
    candidates.sort(key=lambda x: (-x[0], int(x[1].get("ord") or 9999)))
    return candidates[0][1]

def capex_rows(rows):
    out = []
    for r in rows:
        if (r.get("sj_div") or "").upper() != "CF":
            continue
        nm = norm_name(r.get("account_nm") or "")
        aid = (r.get("account_id") or "")
        if "유형자산" in nm and "취득" in nm and "처분" not in nm:
            out.append(r)
        elif "PurchaseOfPropertyPlantAndEquipment" in aid:
            out.append(r)
    # Dedupe exact account IDs/names.
    seen = set()
    deduped = []
    for r in out:
        key = (r.get("account_id") or "", norm_name(r.get("account_nm") or ""))
        if key in seen:
            continue
        seen.add(key)
        deduped.append(r)
    return deduped

def extract_raw(rows, q):
    result = {}
    for metric in ("revenue", "cfo", "op_income"):
        r = choose_row(rows, metric)
        if r:
            cur = amount(r.get("thstrm_amount"))
            add = amount(r.get("thstrm_add_amount"))
            # Repository DART contract: Q2/Q3 flow facts must use cumulative
            # thstrm_add_amount; Q1/annual may fall back to thstrm_amount.
            ytd = add if add is not None else (cur if q in (1, 4) else None)
            result[metric] = {
                "ytd": ytd,
                "account_id": r.get("account_id"),
                "account_nm": r.get("account_nm"),
            }
        else:
            result[metric] = None
    cr = capex_rows(rows)
    if cr:
        ytd_values = []
        for r in cr:
            cur = amount(r.get("thstrm_amount"))
            add = amount(r.get("thstrm_add_amount"))
            ytd = add if add is not None else (cur if q in (1, 4) else None)
            ytd_values.append(ytd)
        result["capex"] = {
            "ytd": sum(v for v in ytd_values if v is not None) if any(v is not None for v in ytd_values) else None,
            "account_id": "|".join(str(r.get("account_id") or "") for r in cr),
            "account_nm": "|".join(str(r.get("account_nm") or "") for r in cr),
        }
    else:
        result["capex"] = None
    return result

def fetch_period(api_key: str, corp_code: str, period: str):
    year, q = qparse(period)
    params = {
        "crtfc_key": api_key,
        "corp_code": corp_code,
        "bsns_year": str(year),
        "reprt_code": REPORT_CODE[q],
        "fs_div": "CFS",
    }
    last_status = None
    for fs_div in ("CFS", "OFS"):
        params["fs_div"] = fs_div
        url = API + "?" + urllib.parse.urlencode(params)
        for attempt in range(3):
            try:
                with urllib.request.urlopen(url, timeout=30) as resp:
                    payload = json.loads(resp.read().decode("utf-8"))
                status = payload.get("status")
                if status == "000" and payload.get("list"):
                    return {
                        "period": period,
                        "fs_div": fs_div,
                        "status": status,
                        "raw": extract_raw(payload["list"], q),
                    }
                last_status = status
                break
