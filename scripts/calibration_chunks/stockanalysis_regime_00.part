def flatcol(c):
    if isinstance(c, tuple):
        parts=[str(x) for x in c if str(x)!='nan' and not str(x).startswith('Unnamed')]
        return parts[-1] if parts else str(c[-1])
    return str(c)

def clean_label(x):
    return re.sub(r"\s+"," ",str(x)).strip()

def num(x):
    if x is None or (isinstance(x,float) and math.isnan(x)): return None
    s=str(x).strip().replace(',','').replace('%','')
    if s in {'','-','—','nan','None'}: return None
    neg=s.startswith('(') and s.endswith(')')
    if neg: s=s[1:-1]
    try: v=float(s)
    except: return None
    return -v if neg else v

def fetch_tables(url):
    for attempt in range(4):
        r=S.get(url,timeout=35)
        if r.status_code==200 and 'Free Cash Flow' in r.text:
            return pd.read_html(StringIO(r.text))
        time.sleep(1.0+attempt)
    raise RuntimeError(f"fetch failed {r.status_code}: {url}")

def table_rows(tables):
    rows={}
    for df in tables:
        df=df.copy(); df.columns=[flatcol(c) for c in df.columns]
        if df.empty: continue
        first=df.columns[0]
        for _,r in df.iterrows():
            label=clean_label(r[first])
            if label and label not in rows:
                rows[label]={clean_label(c):r[c] for c in df.columns[1:]}
    return rows

def qcanon(c):
    m=re.search(r"Q([1-4])\s*(20\d{2})",c)
    return f"{m.group(2)}Q{m.group(1)}" if m else None

def ycanon(c):
    m=re.search(r"FY\s*(20\d{2})",c)
    return int(m.group(1)) if m else None

def extract_series(rows,label,period_kind):
    key=None
    for candidate in rows:
        if clean_label(candidate)==label:
            key=candidate; break
    if key is None: return {}
    out={}
    for c,v in rows[key].items():
        p=qcanon(c) if period_kind=='q' else ycanon(c)
        if p is not None: out[p]=num(v)
    return out

def fetch_company(name,ticker,exchange):
    base=f"https://stockanalysis.com/quote/{exchange}/{ticker}/financials/"
    qrows=table_rows(fetch_tables(base+'?p=quarterly'))
    arows=table_rows(fetch_tables(base))
    out={"name":name,"ticker":ticker,"url":base,"q":{},"annual":{}}
    qlabels={
        "revenue":"Revenue","fcf":"Free Cash Flow","fcf_margin":"FCF Margin",
        "fcf_growth":"Free Cash Flow Growth","revenue_growth":"Revenue Growth","operating_margin":"Operating Margin"}
    for k,l in qlabels.items(): out['q'][k]=extract_series(qrows,l,'q')
    for k,l in {"revenue":"Revenue","fcf":"Free Cash Flow"}.items(): out['annual'][k]=extract_series(arows,l,'y')
    # reconstruct missing Q4 from annual minus Q1-Q3; information is available at annual filing cutoff
    for y in range(2021,2026):
        q4=f"{y}Q4"
        for metric in ("revenue","fcf"):
            if out['q'][metric].get(q4) is None and out['annual'][metric].get(y) is not None:
                prior=[out['q'][metric].get(f"{y}Q{i}") for i in (1,2,3)]
                if all(v is not None for v in prior): out['q'][metric][q4]=out['annual'][metric][y]-sum(prior)
        rev=out['q']['revenue'].get(q4); fcf=out['q']['fcf'].get(q4)
        if rev not in (None,0) and fcf is not None and out['q']['fcf_margin'].get(q4) is None:
            out['q']['fcf_margin'][q4]=100.0*fcf/rev
    return out

def shift(q,n=4):
    y=int(q[:4]); qq=int(q[-1])+n
    while qq>4: y+=1; qq-=4
    while qq<1: y-=1; qq+=4
    return f"{y}Q{qq}"

def classify(origin_fcf,outcome_fcf):
    if origin_fcf is None or outcome_fcf is None or origin_fcf<=0: return None,None
    ratio=outcome_fcf/origin_fcf
    if ratio<LOW: return 'Down',ratio
    if ratio>HIGH: return 'Bull',ratio
    return 'Core',ratio

def brier(P,y):
    return np.mean(np.sum((P-np.eye(3)[y])**2,axis=1))
